{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
, "src/app/api/v1/controller/butchery/route.js", "src/app/api/v1/controller/user/route.js", "src/app/api/v1/model/branches.js", "src/app/api/v1/model/butchery.js", "src/app/api/v1/model/product.js", "src/app/api/v1/model/sales.js", "src/app/api/v1/model/token.js", "src/app/api/v1/model/users.js", "src/app/api/v1/utils/index.js", "components/middlewareAuths/nextAuthProvider.tsx"  ],
  "exclude": [
    "node_modules"
  ]
}
